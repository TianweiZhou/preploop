# Local dev settings. Copy to backend/.env (gitignored) and fill in.
# Load with:  set -a; source .env; set +a

# In-memory DynamoDB, no AWS needed. Data resets on restart.
LOCAL_MOCK_DB=1

# OAuth Client ID from Google Cloud (public, not a secret).
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# The only Google account allowed to sign in.
ALLOWED_EMAIL=you@example.com

# Any long random string for local only. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# In AWS this comes from SSM instead (JWT_SECRET_PARAM).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Safari won't keep Secure cookies on http://localhost. Never set this in AWS.
COOKIE_SECURE=false

# Bedrock model for AI feedback. Check the exact ID (or cross-region inference
# profile ID) in the Bedrock console for your region.
FEEDBACK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_REGION=us-east-1

# AWS profile used locally for Bedrock calls (the table stays in-memory).
# Leave unset if you don't need AI feedback locally.
# AWS_PROFILE=dev
